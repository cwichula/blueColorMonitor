{
  "name": "Light Monitor",
  "short_name": "Light Monitor",
  "description": "Reads the light around you with your camera: it measures blue share, scene brightness, flicker and uniformity, and estimates colour temperature, circadian impact and visual comfort from them. Everything is computed on this device, it works offline and nothing is sent to the network. All seven readings are available right away, with no account and no payment. Not a medical device.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "categories": ["utilities", "productivity"],
  "background_color": "#eff2f8",
  "theme_color": "#eff2f8",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Measure",
      "short_name": "Measure",
      "description": "The lead metric on a gauge and the other six as tiles.",
      "url": "./index.html#/measure",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "History",
      "short_name": "History",
      "description": "The measurement over time, from one minute to thirty days.",
      "url": "./index.html#/history",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Tools",
      "short_name": "Tools",
      "description": "Appearance, zone thresholds, calibration and data export.",
      "url": "./index.html#/tools",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
