{
  "name": "Light Monitor",
  "short_name": "Light Monitor",
  "description": "Measures seven quantities of light with a phone camera: blue share, scene brightness, colour temperature, circadian impact, flicker, uniformity and eye comfort. All seven quantities are available to everyone, without an account and without payment. It works offline and sends nothing to the network.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "categories": ["utilities", "productivity"],
  "background_color": "#F4F6F9",
  "theme_color": "#F4F6F9",
  "icons": [
    { "src": "../icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "../icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "../icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Measure",
      "short_name": "Measure",
      "description": "The large gauge, the verdict on the light and seven tiles.",
      "url": "./index.html#/measure",
      "icons": [{ "src": "../icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "History",
      "short_name": "History",
      "description": "The course of the measurement over time, from a minute to thirty days.",
      "url": "./index.html#/history",
      "icons": [{ "src": "../icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Tools",
      "short_name": "Tools",
      "description": "Thresholds, calibration, reports, export and the documentation of the measurement.",
      "url": "./index.html#/tools",
      "icons": [{ "src": "../icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Support",
      "short_name": "Support",
      "description": "App settings and a voluntary donation to the author.",
      "url": "./index.html#/support",
      "icons": [{ "src": "../icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
